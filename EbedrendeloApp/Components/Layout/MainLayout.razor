@inherits LayoutComponentBase
@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Theme
@inject ICurrentUser CurrentUser
@implements IDisposable

<MudThemeProvider Theme="AppTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       aria-label="Navigáció" />
        <MudText Typo="Typo.h6">Ebédrendelő</MudText>
        <MudSpacer />
        @if (CurrentUser.IsLoaded)
        {
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="px-2">
                <MudAvatar Color="Color.Surface" Size="Size.Small">@Initials</MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2" Style="line-height:1.2;">@CurrentUser.DisplayName</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.75; line-height:1.2;">@(CurrentUser.IsAdmin ? "Admin" : "Dolgozó")</MudText>
                </MudStack>
            </MudStack>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>

    <MudScrollToTop TopOffset="300" ScrollBehavior="ScrollBehavior.Smooth" Style="z-index:1400;">
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.KeyboardArrowUp" aria-label="Vissza a lap tetejére" />
    </MudScrollToTop>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;

    private string Initials => string.Concat(
        CurrentUser.DisplayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]))
            .Take(2));

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.Changed += OnCurrentUserChanged;
        await CurrentUser.EnsureLoadedAsync();
    }

    private void OnCurrentUserChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => CurrentUser.Changed -= OnCurrentUserChanged;
}
