@page "/egyenlegem"
@using EbedrendeloApp.Common.Billing
@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Features.Billing.GetMyBalance
@using EbedrendeloApp.Features.Billing.GetMyCreditLedger
@using MediatR
@inject IMediator Mediator
@inject ICurrentUser CurrentUser

<PageTitle>Egyenlegem</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.AccountBalanceWallet" Title="Egyenlegem">
    <Description>
        A jóváírásaid egyenlege és a mögöttük álló tételes könyvelés.
    </Description>
</PageHeader>

<MudPaper Elevation="1" Class="pa-4 rounded-lg mt-4">
    @if (balanceHuf is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
    }
    else
    {
        <MudStack Spacing="1">
            <MudText Typo="Typo.h3" Color="@(balanceHuf > 0 ? Color.Success : Color.Default)">@HungarianNumberFormat.Huf(balanceHuf)</MudText>
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
                Az egyenleg kizárólag menürendelésre számítható be, a la carte fedezetre nem használható.
            </MudAlert>
        </MudStack>
    }
</MudPaper>

<MudTable Items="ledger" Loading="@(ledger is null)" Hover="true" Elevation="1" Dense="true" Class="mt-4">
    <HeaderContent>
        <MudTh>Dátum</MudTh>
        <MudTh>Típus</MudTh>
        <MudTh>Leírás</MudTh>
        <MudTh Style="text-align:right">Összeg</MudTh>
    </HeaderContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Még nincs jóváírás-tételed.</MudText>
    </NoRecordsContent>
    <RowTemplate>
        <MudTd DataLabel="Dátum">@context.CreatedAtUtc.ToLocalTime().ToString("yyyy.MM.dd. HH:mm")</MudTd>
        <MudTd DataLabel="Típus">
            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudIcon Icon="@CreditEntryDisplay.KindIcon(context.Kind)" Color="@CreditEntryDisplay.KindColor(context.Kind)" Size="Size.Small" />
                <MudText Typo="Typo.body2">@CreditEntryDisplay.KindLabel(context.Kind)</MudText>
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Leírás">@CreditEntryDisplay.Describe(context)</MudTd>
        <MudTd DataLabel="Összeg" Style="text-align:right">
            <MudText Color="@(context.AmountHuf >= 0 ? Color.Success : Color.Error)">@(context.AmountHuf >= 0 ? "+" : "")@HungarianNumberFormat.Huf(context.AmountHuf)</MudText>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private int? balanceHuf;
    private List<CreditLedgerEntryDto>? ledger;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();

        balanceHuf = await Mediator.Send(new GetMyBalanceQuery(CurrentUser.UserId));
        ledger = (await Mediator.Send(new GetMyCreditLedgerQuery(CurrentUser.UserId))).ToList();
    }
}
