@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Features.Billing.GetInvoices
@using EbedrendeloApp.Features.Billing.MarkInvoicePaid
@using MediatR
@inject IMediator Mediator
@inject ICurrentUser CurrentUser

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Paid" Color="Color.Success" Size="Size.Large" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Számla fizetettnek jelölése</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Invoice.UserDisplayName — @Invoice.PeriodName</MudText>
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <MudText>
            Megjelölöd fizetettként a <b>@HungarianNumberFormat.Huf(Invoice.PayableHuf)</b> összegű számlát? A
            művelet nem vonható vissza.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@(isSaving ? null : Icons.Material.Filled.Paid)" OnClick="ConfirmAsync" Disabled="isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Mentés...</MudText>
            }
            else
            {
                <MudText>Fizetettnek jelölés</MudText>
            }
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel" Disabled="isSaving">Mégse</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public InvoiceDto Invoice { get; set; } = default!;

    private bool isSaving;
    private string? errorMessage;

    private void Cancel() => MudDialog.Cancel();

    private async Task ConfirmAsync()
    {
        isSaving = true;
        errorMessage = null;

        var result = await Mediator.Send(new MarkInvoicePaidCommand(Invoice.Id, CurrentUser.UserId));
        isSaving = false;

        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }
    }
}
