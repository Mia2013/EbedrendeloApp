@page "/Error"
@using System.Diagnostics

<PageTitle>Hiba történt</PageTitle>

<MudStack Spacing="3" Class="mt-4">
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
        <MudText Typo="Typo.h5">Hiba történt</MudText>
        <MudText>A kérés feldolgozása közben váratlan hiba lépett fel. Próbáld meg újra; ha a hiba
                 továbbra is fennáll, jelezd a rendszergazdának.</MudText>
    </MudAlert>

    @if (ShowRequestId)
    {
        @* A hibaazonosítót a rendszergazda a naplóban visszakeresi — ezért látszik a felhasználónak. *@
        <MudText>
            <strong>Hibaazonosító:</strong> <code>@RequestId</code>
        </MudText>
    }

    <MudStack Row Spacing="2">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Home">Vissza a kezdőlapra</MudButton>
    </MudStack>
</MudStack>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
