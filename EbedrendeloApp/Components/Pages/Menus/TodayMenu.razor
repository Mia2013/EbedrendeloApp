@page "/mai-menu"
@using EbedrendeloApp.Common.ALaCarte
@using EbedrendeloApp.Common.Allergens
@using EbedrendeloApp.Common.Results
@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Domain.Enums
@using EbedrendeloApp.Features.ALaCarte.PlaceALaCarteOrder
@using EbedrendeloApp.Features.Menus
@using EbedrendeloApp.Features.Menus.GetTodayMenuForUser
@using MediatR
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject IDialogService DialogService

<PageTitle>Mai menü</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
    <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu" Color="Color.Primary" Size="Size.Large" />
    <MudText Typo="Typo.h4" GutterBottom="true">Mai menü</MudText>
</MudStack>

@if (today is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (IsFullyClosedToday)
{
    <MudAlert Severity="Severity.Info">@Describe(today.NotOrderableReason)</MudAlert>
}
else
{
    @if (today.IsOrderableToday)
    {
        <MudPaper Class="pa-3 mb-3" Outlined="true">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Restaurant" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Mai menüválaszték</MudText>
            </MudStack>
            <MudGrid Spacing="2">
                @foreach (var variant in today.Variants)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined="true" Class="pa-3" Style="height:100%;">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-1">
                                <MudText Typo="Typo.subtitle1">@variant.Code menü</MudText>
                                @if (today.MySelection?.VariantCode == variant.Code)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Check">Ezt választottad</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.body2">
                                Leves: @variant.SoupName
                                @if (AllergenCatalog.Format(variant.SoupAllergens) is { } soupAllergens)
                                {
                                    <span class="mud-text-secondary"> (allergén: @soupAllergens)</span>
                                }
                            </MudText>
                            @if (variant.FormatSoup() is { } soupNutrition)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@soupNutrition</MudText>
                            }
                            @if (!string.IsNullOrEmpty(variant.MainCourseName))
                            {
                                <MudText Typo="Typo.body2">
                                    Főétel: @variant.MainCourseName
                                    @if (AllergenCatalog.Format(variant.MainCourseAllergens) is { } mainCourseAllergens)
                                    {
                                        <span class="mud-text-secondary"> (allergén: @mainCourseAllergens)</span>
                                    }
                                </MudText>
                                @if (variant.FormatMainCourse() is { } mainCourseNutrition)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@mainCourseNutrition</MudText>
                                }
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudAlert Severity="@(today.MySelection is null ? Severity.Warning : Severity.Success)" Class="mb-3" Dense="true">
            @(today.MySelection is { } selection
                ? $"Ma a(z) {selection.VariantCode} menüt ({selection.VariantName}) rendelted, {HungarianNumberFormat.Huf(selection.PriceHuf)} értékben."
                : "Ma még nem rendeltél menüt.")
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">@Describe(today.NotOrderableReason)</MudAlert>
    }

    <MudPaper Class="pa-3" Outlined="true">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Fastfood" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Mai à la carte kínálat</MudText>
            </MudStack>
            @if (today.IsALaCarteOrderableNow)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Schedule">
                    @today.ALaCarteOrderDeadlineLocalTime.ToString("HH:mm")-ig rendelhető
                </MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Schedule">
                    A mai rendelési határidő lejárt
                </MudChip>
            }
        </MudStack>

        @if (!string.IsNullOrEmpty(orderErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@orderErrorMessage</MudAlert>
        }

        @if (today.ALaCarteOffers.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Ma nincs à la carte kínálat.</MudText>
        }
        else
        {
            @foreach (var group in today.ALaCarteOffers.GroupBy(o => o.Category))
            {
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mt-3 mb-2">
                    <MudIcon Icon="@ALaCarteCategoryDisplay.Icon(group.Key)" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@ALaCarteCategoryDisplay.Name(group.Key)</MudText>
                </MudStack>
                <MudGrid Spacing="2">
                    @foreach (var offer in group)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Outlined="true" Class="pa-3" Style="@CardStyle(offer)" Elevation="0"
                                      @onclick="@(() => OnCardClick(offer))">
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-1">
                                    <MudText Typo="Typo.subtitle2">@offer.Name@(offer.IncludesSoup ? " (levessel)" : "")</MudText>
                                    @* Fix méretű (szélesség ÉS magasság) hely a jelölő chipnek: a "Kiválasztva" chip
                                       DOM-elem mindig ott van, kiválasztatlanul csak visibility:hidden — így a hely
                                       mindig foglalt, kattintásra sem a névsor tördelése, sem a kártya magassága
                                       nem ugrik meg. *@
                                    <div style="min-width:112px; text-align:right;">
                                        @if (IsOrdered(offer))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">Megrendelve</MudChip>
                                        }
                                        else if (offer.FreeCount == 0)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Elfogyott</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Check"
                                                     Style="@(IsSelected(offer) ? "" : "visibility:hidden;")">Kiválasztva</MudChip>
                                        }
                                    </div>
                                </MudStack>
                                @if (AllergenCatalog.FormatNumbersOnly(offer.Allergens) is { } allergensShort)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display:block;">
                                        Allergén: @allergensShort
                                        <MudTooltip Text="@AllergenCatalog.Format(offer.Allergens)" Inline="true">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ml-1" />
                                        </MudTooltip>
                                    </MudText>
                                }
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@HungarianNumberFormat.Huf(offer.PriceHuf)</MudText>
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        @if (!IsOrdered(offer) && offer.FreeCount > 0)
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Szabad: @HungarianNumberFormat.Number(offer.FreeCount)</MudText>
                                        }
                                        @if (FormatALaCarteNutrition(offer) is { } nutrition)
                                        {
                                            <MudTooltip Text="@nutrition" Inline="true">
                                                <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Size="Size.Small" Color="Color.Secondary" />
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }

            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(selectedItemIds.Count == 0
                        ? "Nincs kiválasztott tétel."
                        : $"{selectedItemIds.Count} tétel kiválasztva, összesen {HungarianNumberFormat.Huf(SelectedTotalHuf)}.")
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCart"
                           Disabled="@(!CanOpenOrderDialog)"
                           OnClick="OpenOrderConfirmDialogAsync">
                    Megrendelés
                </MudButton>
            </MudStack>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-2">Saját à la carte rendelésed</MudText>
        @if (today.MyALaCarteOrderLines.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Ma nem rendeltél à la carte tételt.</MudText>
        }
        else
        {
            <MudStack Spacing="1" Class="mt-1">
                @foreach (var line in today.MyALaCarteOrderLines)
                {
                    <MudText Typo="Typo.body2">@line.ItemName@(line.IncludesSoup ? " (levessel)" : "") (@ALaCarteCategoryDisplay.Name(line.Category)) — @HungarianNumberFormat.Huf(line.UnitPriceHuf)</MudText>
                }
            </MudStack>
        }
    </MudPaper>
}

@code {
    private static readonly Dictionary<string, string> ReasonText = new()
    {
        [ErrorCodes.NotWorkingDay] = "Ma hétvége van, nincs kiszolgálás.",
        [ErrorCodes.DayExcluded] = "A mai nap ki van zárva, nincs kiszolgálás.",
        [ErrorCodes.MenuNotPublished] = "Mára még nincs publikált menü.",
    };

    private static readonly Dictionary<string, string> ALaCarteOrderErrorText = new()
    {
        [ErrorCodes.OutOfStock] = "Ez a tétel időközben elfogyott.",
        [ErrorCodes.AlreadyOrdered] = "Ezt a tételt már megrendelted ma.",
        [ErrorCodes.DeadlinePassed] = "A mai à la carte rendelési határidő már lejárt.",
        [ErrorCodes.NotDirectlyOrderable] = "A leves önállóan nem rendelhető.",
        [ErrorCodes.OfferNotFound] = "A tétel ma már nem elérhető.",
        [ErrorCodes.NotWorkingDay] = "Ma nem munkanap.",
        [ErrorCodes.DayExcluded] = "A mai nap ki van zárva.",
        [ErrorCodes.OutsidePeriod] = "Ma nincs érvényes rendelési időszak.",
    };

    private static readonly DialogOptions ConfirmDialogOptions = new()
    {
        CloseButton = true,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    private TodayMenuDto? today;
    private readonly HashSet<int> selectedItemIds = [];
    private bool isPlacingOrder;
    private string? orderErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        today = await Mediator.Send(new GetTodayMenuForUserQuery(CurrentUser.UserId));
    }

    private static string Describe(string? reason) => reason is null ? string.Empty : ReasonText.GetValueOrDefault(reason, reason);

    /// <summary>Csak hétvégén/kizárt napon nincs semmilyen kiszolgálás — ilyenkor az à la carte rész is
    /// üres (AC 4.1.3/4.2.7), a teljes oldalt egyetlen jelzés helyettesíti. "Nincs publikált menü" ennél
    /// gyengébb: az à la carte a napi menütől függetlenül rendelhető (AC 4.2.6), ezért az nem zárja be a
    /// teljes oldalt, csak a menüválaszték-szekciót.</summary>
    private bool IsFullyClosedToday => today is not null && !today.IsOrderableToday
        && today.NotOrderableReason is ErrorCodes.NotWorkingDay or ErrorCodes.DayExcluded;

    private bool IsOrdered(ALaCarteOfferDto offer) => today!.MyALaCarteOrderLines.Any(l => l.ALaCarteItemId == offer.ALaCarteItemId);

    private bool IsSelected(ALaCarteOfferDto offer) => selectedItemIds.Contains(offer.ALaCarteItemId);

    private bool CanSelect(ALaCarteOfferDto offer) => today!.IsALaCarteOrderableNow && !isPlacingOrder;

    private bool CanClickCard(ALaCarteOfferDto offer) => !IsOrdered(offer) && offer.FreeCount > 0 && CanSelect(offer);

    private List<ALaCarteOfferDto> SelectedOffers => today!.ALaCarteOffers.Where(o => selectedItemIds.Contains(o.ALaCarteItemId)).ToList();

    private int SelectedTotalHuf => SelectedOffers.Sum(o => o.PriceHuf);

    private bool CanOpenOrderDialog => selectedItemIds.Count > 0 && today!.IsALaCarteOrderableNow && !isPlacingOrder;

    private string CardStyle(ALaCarteOfferDto offer)
    {
        if (IsSelected(offer))
        {
            return "cursor:pointer; background:var(--mud-palette-primary-hover);";
        }

        return CanClickCard(offer) ? "cursor:pointer;" : "opacity:0.7;";
    }

    /// <summary>Kategóriánként legfeljebb egy tétel választható (rádiógomb-viselkedés — pl. 1 főétel,
    /// 1 köret) — kijelöléskor előbb töröljük az adott kategóriában esetleg már kiválasztott tételt.
    /// Már megrendelt vagy elfogyott tételre kattintva nem történik semmi.</summary>
    private void OnCardClick(ALaCarteOfferDto offer)
    {
        if (!CanClickCard(offer))
        {
            return;
        }

        if (IsSelected(offer))
        {
            selectedItemIds.Remove(offer.ALaCarteItemId);
        }
        else
        {
            selectedItemIds.RemoveWhere(id => today!.ALaCarteOffers.Any(o => o.ALaCarteItemId == id && o.Category == offer.Category));
            selectedItemIds.Add(offer.ALaCarteItemId);
        }
    }

    /// <summary>A leves sosem szerepel önálló sorként a kínálatban (lásd <c>GetTodayMenuForUserHandler</c>) —
    /// az ára automatikusan beleolvad minden Főétel árába, amit a sor "(levessel)" jelzése már mutat, ezért
    /// itt nincs (és nem is lehet) külön leves-kijelölés, amit a Főétel kijelölésekor automatikusan be kéne
    /// pipálni.</summary>
    private async Task OpenOrderConfirmDialogAsync()
    {
        var parameters = new DialogParameters<ALaCarteOrderConfirmDialog> { { x => x.Offers, SelectedOffers } };
        var dialogRef = await DialogService.ShowAsync<ALaCarteOrderConfirmDialog>("Rendelés megerősítése", parameters, ConfirmDialogOptions);
        var result = await dialogRef.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await PlaceSelectedOrderAsync();
    }

    private async Task PlaceSelectedOrderAsync()
    {
        isPlacingOrder = true;
        orderErrorMessage = null;

        var result = await Mediator.Send(new PlaceALaCarteOrderCommand(CurrentUser.UserId, selectedItemIds.ToList()));

        isPlacingOrder = false;

        if (result.IsSuccess)
        {
            selectedItemIds.Clear();
            today = await Mediator.Send(new GetTodayMenuForUserQuery(CurrentUser.UserId));
        }
        else
        {
            orderErrorMessage = result.ErrorCode is { } code && ALaCarteOrderErrorText.TryGetValue(code, out var text) ? text : result.ErrorMessage;
        }
    }

    private static string? FormatALaCarteNutrition(ALaCarteOfferDto offer) => MenuVariantNutritionFormat.Format(
        offer.EnergyKcal, offer.FatGrams, offer.SaturatedFatGrams, offer.CarbohydrateGrams, offer.SugarGrams, offer.ProteinGrams, offer.SaltGrams);
}
