@page "/etlap"
@using EbedrendeloApp.Common.Allergens
@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Components.Shared
@using EbedrendeloApp.Domain.Enums
@using EbedrendeloApp.Features.Calendar
@using EbedrendeloApp.Features.Calendar.GetOrderingPeriods
@using EbedrendeloApp.Features.Menus
@using EbedrendeloApp.Features.Menus.GetDailyMenu
@using EbedrendeloApp.Features.Menus.GetMenuDishSuggestions
@using EbedrendeloApp.Features.Menus.GetPeriodMenu
@using MediatR
@inject IMediator Mediator
@inject IDialogService DialogService
@inject ICurrentUser CurrentUser
@inject NavigationManager NavigationManager

<PageTitle>Napi menü szerkesztése</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.RestaurantMenu" Title="Napi menü szerkesztése">
    <Description>
        Válassz egy rendelési időszakot — csak az ahhoz tartozó munkanapok listázódnak. Elmúlt napok menüje
        csak megtekinthető.
    </Description>
    <Filters>
        @if (!isLoadingPeriods && periods.Count > 0)
        {
            <PeriodSelector Periods="periods" Value="selectedPeriodId" ValueChanged="OnPeriodSelectedAsync" />
        }
    </Filters>
</PageHeader>

<PageState IsLoading="@(isLoadingPeriods || isLoadingDays)"
           IsEmpty="@(!isLoadingPeriods && periods.Count == 0)"
           EmptyText="Még nincs rendelési időszak."
           EmptyIcon="@Icons.Material.Filled.DateRange">
    @if (SelectedPeriod is { } period)
    {
        <WeekGrid StartDate="period.StartDate" EndDate="period.EndDate" Today="today">
            <CellContent Context="date">
                @if (days.FirstOrDefault(d => d.Date == date) is { } cell)
                {
                    @DayCell(cell)
                }
            </CellContent>
        </WeekGrid>
    }
</PageState>

@code {
    /// <summary>Egyetlen közös sablon a naptár-rács minden napcellájához (Razor templated delegate,
    /// <see cref="RenderFragment{TValue}"/>) — a fejléc (avatar+dátum / hét napja / akció ikonok) felül,
    /// a variáns-lista (vagy "nincs menü" felirat) alatta.</summary>
    private RenderFragment<DayRow> DayCell => day =>
    @<MudStack Spacing="1" Style="height:100%;">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="flex-shrink-0">
                <MudText Typo="Typo.subtitle2" Class="@GetTextClass(day)" Color="@(day.IsPastDay ? Color.Default : Color.Primary)" Style="font-weight:700;">@day.Date.ToString("MM.dd.")</MudText>
                @if (day.Date == today)
                {
                    <MudBadge Content="@("Ma")" Color="Color.Primary" />
                }
            </MudStack>

            <MudStack Row Spacing="0" Class="flex-shrink-0">
                <MudIconButton Class="pa-1" Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Variant="Variant.Text" Size="Size.Small"
                               title="@(day.IsPastDay ? "Elmúlt, csak megtekinthető" : "Szerkesztés")"
                               OnClick="() => EditDayAsync(day)" Disabled="!day.CanEdit" />
                <MudIconButton Class="pa-1" Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" Variant="Variant.Text" Size="Size.Small"
                               title="Nap menüjének törlése" OnClick="() => DeleteDayRowAsync(day)"
                               Disabled="!day.CanDelete" />
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrEmpty(day.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@day.ErrorMessage</MudAlert>
        }

        @if (day.HasMenu)
        {
            <MudGrid Spacing="2">
                @for (var variantIndex = 0; variantIndex < day.Variants.Count; variantIndex++)
                {
                    var variant = day.Variants[variantIndex];
                    <MudItem xs="12" md="4" lg="12">
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Start">
                            <MudAvatar Color="@(day.IsPastDay ? Color.Default : Color.Warning)" Size="Size.Small" Rounded="true">@variant.Code</MudAvatar>
                            <MudStack Spacing="0" Class="flex-grow-1" Style="min-width:0;">
                                <MudText Typo="Typo.body2" Class="@GetTextClass(day)">
                                    @variant.SoupName
                                    @if (FormatAllergensShort(variant.SoupDish) is { } soupAllergensShort)
                                    {
                                        <text> (@soupAllergensShort)</text>
                                        <MudTooltip Text="@FormatAllergens(variant.SoupDish)" Inline="true">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ml-1" />
                                        </MudTooltip>
                                    }
                                </MudText>
                                @if (FormatNutrition(variant.SoupDish) is { } soupNutritionText)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@soupNutritionText</MudText>
                                }

                                @if (!string.IsNullOrWhiteSpace(variant.MainCourseName))
                                {
                                    <MudText Typo="Typo.body2" Class="@GetTextClass(day, "mt-1")">
                                        @variant.MainCourseName
                                        @if (FormatAllergensShort(variant.MainCourseDish) is { } mainCourseAllergensShort)
                                        {
                                            <text> (@mainCourseAllergensShort)</text>
                                            <MudTooltip Text="@FormatAllergens(variant.MainCourseDish)" Inline="true">
                                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ml-1" />
                                            </MudTooltip>
                                        }
                                    </MudText>
                                    @if (FormatNutrition(variant.MainCourseDish) is { } mainCourseNutritionText)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@mainCourseNutritionText</MudText>
                                    }
                                }
                            </MudStack>
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nincs még menü erre a napra.</MudText>
        }
    </MudStack>;
}

@code {
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);

    private sealed class VariantRow
    {
        public string Code { get; set; } = string.Empty;
        public MenuDishDto? SoupDish { get; set; }
        public MenuDishDto? MainCourseDish { get; set; }

        public string SoupName => SoupDish?.Name ?? string.Empty;
        public string MainCourseName => MainCourseDish?.Name ?? string.Empty;
    }

    private sealed class DayRow
    {
        public required DateOnly Date { get; init; }
        public required bool IsPastDay { get; init; }
        public bool HasMenu { get; set; }
        public List<VariantRow> Variants { get; set; } = [];
        public bool IsSaving { get; set; }
        public string? ErrorMessage { get; set; }

        public bool CanEdit => !IsPastDay && !IsSaving;
        public bool CanDelete => !IsPastDay && !IsSaving && HasMenu;
    }

    private List<OrderingPeriodDto> periods = [];
    private int selectedPeriodId;
    private List<DayRow> days = [];
    private bool isLoadingPeriods = true;
    private bool isLoadingDays;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        if (!CurrentUser.IsAdmin)
        {
            NavigationManager.NavigateTo("mai-menu");
            return;
        }

        periods = (await Mediator.Send(new GetOrderingPeriodsQuery())).OrderByDescending(p => p.StartDate).ToList();
        isLoadingPeriods = false;

        var current = periods.FirstOrDefault(p => p.StartDate <= today && p.EndDate >= today) ?? periods.FirstOrDefault();
        if (current is not null)
        {
            selectedPeriodId = current.Id;
            await LoadDaysAsync();
        }
    }

    private async Task OnPeriodSelectedAsync(int periodId)
    {
        selectedPeriodId = periodId;
        await LoadDaysAsync();
    }

    private async Task LoadDaysAsync()
    {
        var period = periods.FirstOrDefault(p => p.Id == selectedPeriodId);
        if (period is null)
        {
            days = [];
            return;
        }

        isLoadingDays = true;

        var menuResult = await Mediator.Send(new GetPeriodMenuQuery(selectedPeriodId, IncludeUnpublished: true));
        var menusByDate = menuResult.IsSuccess
            ? menuResult.Value!.ToDictionary(m => m.Date)
            : [];

        var newDays = new List<DayRow>();
        for (var date = period.StartDate; date <= period.EndDate; date = date.AddDays(1))
        {
            if (date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
            {
                continue;
            }

            menusByDate.TryGetValue(date, out var dto);
            newDays.Add(new DayRow
            {
                Date = date,
                IsPastDay = date < today,
                HasMenu = dto is not null,
                Variants = dto?.Variants.Select(ToVariantRow).ToList() ?? [],
            });
        }

        days = newDays;
        isLoadingDays = false;
    }

    /// <summary>A hétfő–péntek rácsot a közös `WeekGrid` építi az időszak dátumtartományából; a
    /// cella-sablon dátum szerint keresi ki a saját `DayRow`-ját.</summary>
    private OrderingPeriodDto? SelectedPeriod => periods.FirstOrDefault(p => p.Id == selectedPeriodId);

    /// <summary>Muted grey for an elmúlt (past) day's text — a subtle "not editable anymore" cue.</summary>
    private static string? GetTextClass(DayRow day, string? extra = null)
    {
        if (!day.IsPastDay)
        {
            return extra;
        }

        return extra is null ? "mud-text-secondary" : $"mud-text-secondary {extra}";
    }

    /// <summary>View-mód: csak a megjelenítéshez szükséges mezők, katalógus-egyeztetés nélkül (arra csak a
    /// szerkesztő-dialógusban van szükség, ahol a szerkesztés-ceruzának Id kell).</summary>
    private static VariantRow ToVariantRow(MenuVariantDto v) => new()
    {
        Code = v.Code,
        SoupDish = new MenuDishDto(
            v.SoupName, v.SoupAllergens, v.SoupEnergyKcal, v.SoupFatGrams, v.SoupSaturatedFatGrams,
            v.SoupCarbohydrateGrams, v.SoupSugarGrams, v.SoupProteinGrams, v.SoupSaltGrams, Kind: MenuDishKind.Leves),
        MainCourseDish = v.MainCourseName is null ? null : new MenuDishDto(
            v.MainCourseName, v.MainCourseAllergens, v.MainCourseEnergyKcal, v.MainCourseFatGrams, v.MainCourseSaturatedFatGrams,
            v.MainCourseCarbohydrateGrams, v.MainCourseSugarGrams, v.MainCourseProteinGrams, v.MainCourseSaltGrams, Kind: MenuDishKind.Foetel),
    };

    private static string? FormatAllergens(MenuDishDto? dish) => dish is null ? null : AllergenCatalog.Format(dish.Allergens);

    private static string? FormatAllergensShort(MenuDishDto? dish) => dish is null ? null : AllergenCatalog.FormatNumbersOnly(dish.Allergens);

    private static string? FormatNutrition(MenuDishDto? dish) => dish is null ? null : MenuVariantNutritionFormat.Format(
        dish.EnergyKcal, dish.FatGrams, dish.SaturatedFatGrams, dish.CarbohydrateGrams, dish.SugarGrams, dish.ProteinGrams, dish.SaltGrams);

    /// <summary>Re-reads one day from the server without touching any other row.</summary>
    private async Task RefreshRowDataAsync(DayRow row)
    {
        var dto = await Mediator.Send(new GetDailyMenuQuery(row.Date, IncludeUnpublished: true));
        row.HasMenu = dto is not null;
        row.Variants = dto?.Variants.Select(ToVariantRow).ToList() ?? [];
    }

    private static readonly DialogOptions EditDialogOptions = new()
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    private async Task EditDayAsync(DayRow day)
    {
        var parameters = new DialogParameters<EditDailyMenuDialog> { { x => x.Date, day.Date } };
        var dialogRef = await DialogService.ShowAsync<EditDailyMenuDialog>("Nap menüjének szerkesztése", parameters, EditDialogOptions);
        var result = await dialogRef.Result;
        if (result is { Canceled: false })
        {
            await RefreshRowDataAsync(day);
        }
    }

    private async Task DeleteDayRowAsync(DayRow day)
    {
        var parameters = new DialogParameters<DeleteDailyMenuDialog> { { x => x.Date, day.Date } };
        var dialogRef = await DialogService.ShowAsync<DeleteDailyMenuDialog>("Nap menüjének törlése", parameters);
        var result = await dialogRef.Result;
        if (result is { Canceled: false })
        {
            await RefreshRowDataAsync(day);
        }
    }
}
