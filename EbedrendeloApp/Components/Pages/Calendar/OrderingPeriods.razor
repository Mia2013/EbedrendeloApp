@page "/idoszakok"
@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Features.Calendar
@using EbedrendeloApp.Features.Calendar.GetOrderingPeriods
@using MediatR
@inject IMediator Mediator
@inject IDialogService DialogService
@inject ICurrentUser CurrentUser
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Rendelési időszakok</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.DateRange" Title="Rendelési időszakok" Class="mb-4">
    <Description>
        Nem naptári hónapokhoz kötött rendelési ciklusok. Átfedés nem engedélyezett, rés megengedett.
    </Description>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">
            Új időszak
        </MudButton>
    </Actions>
</PageHeader>

<MudAlert Severity="Severity.Info" Class="my-4">
    Ha egy időszakhoz már tartozik rendelés, a kezdő-, záró- és leadási határidő nem módosítható — csak a
    a nyitva tartás. Egy dátum kizárásához a „Nem rendelhető napok" funkciót használd.
</MudAlert>

<MudTable Items="@(periods ?? [])" Loading="@(periods is null)" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>Név</MudTh>
            <MudTh>Kezdés</MudTh>
            <MudTh>Zárás</MudTh>
            <MudTh>Leadási határidő</MudTh>
            <MudTh>Állapot</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Név">@context.Name</MudTd>
            <MudTd DataLabel="Kezdés">@context.StartDate.ToString("yyyy.MM.dd.")</MudTd>
            <MudTd DataLabel="Zárás">@context.EndDate.ToString("yyyy.MM.dd.")</MudTd>
            <MudTd DataLabel="Leadási határidő">@context.OrderDeadline.ToString("yyyy.MM.dd. HH:mm")</MudTd>
            <MudTd DataLabel="Állapot">
                <MudChip T="string" Color="@(context.IsOpen ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.IsOpen ? "Nyitva" : "Zárva")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => OpenEditDialogAsync(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>

@code {
    private IReadOnlyList<OrderingPeriodDto>? periods;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        if (!CurrentUser.IsAdmin)
        {
            NavigationManager.NavigateTo("naptar");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        periods = await Mediator.Send(new GetOrderingPeriodsQuery());
    }

    private static readonly DialogOptions DefaultDialogOptions = new()
    {
        CloseButton = true,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    private async Task OpenCreateDialogAsync()
    {
        var dialogRef = await DialogService.ShowAsync<OrderingPeriodDialog>("Új rendelési időszak", DefaultDialogOptions);
        var result = await dialogRef.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Rendelési időszak létrehozva.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialogAsync(OrderingPeriodDto period)
    {
        var parameters = new DialogParameters<OrderingPeriodDialog>
        {
            { x => x.Existing, period },
        };
        var dialogRef = await DialogService.ShowAsync<OrderingPeriodDialog>("Rendelési időszak szerkesztése", parameters, DefaultDialogOptions);
        var result = await dialogRef.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Rendelési időszak mentve.", Severity.Success);
            await LoadAsync();
        }
    }
}
