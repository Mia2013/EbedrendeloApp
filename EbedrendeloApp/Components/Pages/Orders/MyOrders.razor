@page "/rendeleseim"
@using EbedrendeloApp.Common.Orders
@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Components.Shared
@using EbedrendeloApp.Domain.Enums
@using EbedrendeloApp.Features.Calendar
@using EbedrendeloApp.Features.Calendar.GetOrderingPeriods
@using EbedrendeloApp.Features.Orders.GetMyPeriodOrder
@using MediatR
@inject IMediator Mediator
@inject ICurrentUser CurrentUser

<PageTitle>Rendeléseim</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Receipt" Title="Rendeléseim">
    <Description>
        A kiválasztott időszakra leadott és lemondott rendeléseid, naptár nézetben.
    </Description>
    <Filters>
        @if (periods is { Count: > 0 })
        {
            <PeriodSelector Periods="periods" Value="selectedPeriodId" ValueChanged="OnPeriodSelectedAsync" />
        }
    </Filters>
</PageHeader>

<PageState IsLoading="@(days is null && string.IsNullOrEmpty(errorMessage))" ErrorMessage="@errorMessage">
    @if (SelectedPeriod is { } period)
    {
        <WeekGrid StartDate="period.StartDate" EndDate="period.EndDate" Today="today" CellContent="DayCell" />
    }
</PageState>

@code {
    private RenderFragment<DateOnly> DayCell => date =>
    @<MudStack Spacing="1" Style="height:100%;">
        <MudText Typo="Typo.subtitle2" Color="@(date < today ? Color.Default : Color.Primary)" Style="font-weight:700;">@date.ToString("MM.dd.")</MudText>

        @if (!ordersByDate.TryGetValue(date, out var orders) || orders.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nem rendeltél erre a napra</MudText>
        }
        else
        {
            @foreach (var order in orders.OrderBy(o => o.PlacedAtUtc))
            {
                <MudStack Spacing="0" Class="mb-2">
                    <MudChip T="string" Size="Size.Small" Color="@(order.Status == OrderStatus.Active ? Color.Success : Color.Default)">
                        @(order.Status == OrderStatus.Active ? "Aktív" : "Lemondva")
                    </MudChip>
                    <MudText Typo="Typo.body2" Style="@(order.Status == OrderStatus.Active ? null : "text-decoration:line-through;")" Class="@(order.Status == OrderStatus.Active ? null : "mud-text-secondary")">
                        @order.VariantCode menü — @order.VariantName
                    </MudText>

                    @if (order.PlacedByDisplayName is { } placedBy)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary">Leadta: @placedBy</MudText>
                    }
                    @if (order.ReassignedFromVariantCode is { } reassignedFrom)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary">Áthelyezve — eredetileg @reassignedFrom menüről</MudText>
                    }
                    @if (order.Status == OrderStatus.Cancelled)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @CancellationReasonDisplay.UserText(order.CancellationReason) — @order.CancelledAtUtc?.ToString("yyyy.MM.dd. HH:mm")
                        </MudText>
                    }
                </MudStack>
            }
        }
    </MudStack>;

    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);

    private List<OrderingPeriodDto> periods = [];
    private int selectedPeriodId;
    private List<MyPeriodOrderDto>? days;
    private Dictionary<DateOnly, List<MyPeriodOrderDto>> ordersByDate = [];
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();

        periods = (await Mediator.Send(new GetOrderingPeriodsQuery())).OrderByDescending(p => p.StartDate).ToList();
        var current = periods.FirstOrDefault(p => p.StartDate <= today && p.EndDate >= today) ?? periods.FirstOrDefault();

        if (current is not null)
        {
            selectedPeriodId = current.Id;
            await LoadDaysAsync();
        }
        else
        {
            days = [];
            errorMessage = "Nincs még rendelési időszak.";
        }
    }

    private async Task OnPeriodSelectedAsync(int periodId)
    {
        selectedPeriodId = periodId;
        days = null;
        StateHasChanged();
        await LoadDaysAsync();
    }

    private async Task LoadDaysAsync()
    {
        var result = await Mediator.Send(new GetMyPeriodOrderQuery(CurrentUser.UserId, selectedPeriodId));
        if (!result.IsSuccess)
        {
            days = [];
            errorMessage = result.ErrorMessage;
            return;
        }

        errorMessage = null;
        days = result.Value!.ToList();
        ordersByDate = days.GroupBy(o => o.Date).ToDictionary(g => g.Key, g => g.ToList());
    }

    /// <summary>A rácsot a `WeekGrid` építi az időszak dátumtartományából — a `GetMyPeriodOrderQuery`
    /// csak a ténylegesen létező rendeléseket adja vissza, ezért a naptár a periódus munkanapjait
    /// sorolja fel, nem a visszakapott listát.</summary>
    private OrderingPeriodDto? SelectedPeriod => periods.FirstOrDefault(p => p.Id == selectedPeriodId);
}
