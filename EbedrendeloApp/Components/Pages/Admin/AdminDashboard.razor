@page "/admin"
@using EbedrendeloApp.Common.Admin
@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Features.Admin.GetAdminDashboard
@using MediatR
@using MudBlazor.Charts
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@inject NavigationManager NavigationManager

<PageTitle>Áttekintés</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Dashboard" Title="Áttekintés" Class="mb-6">
    <Description>
        @TodayText — ami ma az adminra vár, és ahonnan minden admin oldal egy kattintásra van.
    </Description>
    <Actions>
        @if (dashboard?.ActivePeriod is { } period)
        {
            <MudChip T="string" Variant="Variant.Outlined" Color="@(period.IsOpen ? Color.Success : Color.Default)"
                     Icon="@(period.IsOpen ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)">
                @period.Name — @(period.IsOpen ? "nyitva" : "lezárva")
            </MudChip>
        }
    </Actions>
</PageHeader>

<PageState IsLoading="@(dashboard is null)" LoadingText="Áttekintés betöltése…">
    @if (dashboard is { } data)
    {
        <MudGrid Spacing="6">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg" Style="height:100%">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Start">
                        <MudStack Spacing="0" Class="flex-grow-1">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Mai adagok</MudText>
                            <MudText Typo="Typo.h4">@HungarianNumberFormat.Number(data.TodayMenuPortions)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@VariantBreakdown</MudText>
                        </MudStack>
                        <MudPaper Elevation="0" Class="pa-2 rounded" Style="background:var(--mud-palette-primary-hover)">
                            <MudIcon Icon="@Icons.Material.Filled.SoupKitchen" Color="Color.Primary" />
                        </MudPaper>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg" Style="height:100%">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Start">
                        <MudStack Spacing="0" Class="flex-grow-1">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Aktív időszak</MudText>
                            <MudText Typo="Typo.h5" Class="mt-1">@(data.ActivePeriod?.Name ?? "Nincs")</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@PeriodSubtitle</MudText>
                        </MudStack>
                        <MudPaper Elevation="0" Class="pa-2 rounded" Style="background:var(--mud-palette-primary-hover)">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" />
                        </MudPaper>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg" Style="height:100%">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Start">
                        <MudStack Spacing="0" Class="flex-grow-1">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Menü nélküli munkanap</MudText>
                            <MudText Typo="Typo.h4">@HungarianNumberFormat.Number(data.MissingDailyMenuCount)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@MissingMenuSubtitle</MudText>
                        </MudStack>
                        <MudPaper Elevation="0" Class="pa-2 rounded" Style="background:var(--mud-palette-warning-hover)">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                        </MudPaper>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg" Style="height:100%">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Start">
                        <MudStack Spacing="0" Class="flex-grow-1">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Fizetetlen számla</MudText>
                            <MudText Typo="Typo.h4" Color="@(data.UnpaidInvoiceCount > 0 ? Color.Error : Color.Default)">
                                @HungarianNumberFormat.Number(data.UnpaidInvoiceCount)
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @HungarianNumberFormat.Huf(data.UnpaidInvoiceTotalHuf) kintlévőség
                            </MudText>
                        </MudStack>
                        <MudPaper Elevation="0" Class="pa-2 rounded" Style="background:var(--mud-palette-error-hover)">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Error" />
                        </MudPaper>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="1" Class="pa-4 rounded-lg mt-6">
            <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline" Class="mb-1">
                <MudText Typo="Typo.h6">Mai teendők</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@TodoCountText</MudText>
            </MudStack>

            @if (data.Todos.Count == 0)
            {
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="py-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Ma nincs elmaradás — minden nap fel van töltve, és nincs kifizetetlen számla.</MudText>
                </MudStack>
            }
            else
            {
                <MudGrid Spacing="0">
                    @foreach (var todo in data.Todos)
                    {
                        <MudItem xs="12" md="6">
                            <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Class="py-2 pe-md-6">
                                <MudIcon Icon="@AdminTodoDisplay.Icon(todo.Kind)" Color="@AdminTodoDisplay.Color(todo.Kind)" />
                                <MudStack Spacing="0" Class="flex-grow-1">
                                    <MudText Typo="Typo.body2">@AdminTodoDisplay.Title(todo)</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@AdminTodoDisplay.Detail(todo)</MudText>
                                </MudStack>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           EndIcon="@Icons.Material.Filled.ChevronRight"
                                           Href="@AdminTodoDisplay.Href(todo.Kind)">
                                    @AdminTodoDisplay.ActionLabel(todo.Kind)
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>

        <MudGrid Spacing="6" Class="mt-0" Justify="Justify.FlexStart">
            <MudItem xs="12" md="5">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline">
                        <MudText Typo="Typo.h6">Mai menü</MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   EndIcon="@Icons.Material.Filled.ChevronRight" Href="etlap">
                            Étlap
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Előre leadott menürendelés · @HungarianNumberFormat.Number(data.TodayMenuPortions) adag
                    </MudText>

                    @if (data.TodayMenuVariants.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                            Mára nincs publikált napi menü.
                        </MudAlert>
                    }
                    else
                    {
                        <MudList T="string" Class="mt-2" Dense="true">
                            @foreach (var variant in data.TodayMenuVariants)
                            {
                                <MudListItem T="string">
                                    <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                                        <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@variant.Code</MudAvatar>
                                        <MudText Typo="Typo.body2" Class="flex-grow-1">@variant.Name</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight:500">@HungarianNumberFormat.Number(variant.Portions) adag</MudText>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <MudDivider Class="my-2" />
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" Class="mud-text-secondary" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@CancelledText</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline">
                        <MudText Typo="Typo.h6">Mai à la carte</MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   EndIcon="@Icons.Material.Filled.ChevronRight" Href="alacarte-konyhai-lista">
                            Konyhai lista
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@ALaCarteSubtitle</MudText>

                    @if (data.TodayALaCarteOffers.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                            Mára nincs kiajánlva egyetlen à la carte tétel sem.
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid Spacing="0" Class="mt-2">
                            @foreach (var offer in data.TodayALaCarteOffers)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Class="py-1 pe-sm-6">
                                        <MudText Typo="Typo.body2" Class="flex-grow-1">@offer.Name</MudText>
                                        <MudText Typo="Typo.body2" Class="@(offer.OrderedCount == 0 ? "mud-text-secondary" : null)" Style="font-weight:500">
                                            @OrderedText(offer.OrderedCount)
                                        </MudText>
                                    </MudStack>
                                </MudItem>
                            }
                        </MudGrid>
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-4">Napi à la carte rendelés</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Rendelt tételek kategóriánként, a héten</MudText>
                    <MudChart T="double" ChartType="ChartType.StackedBar"
                              ChartSeries="@ALaCarteSeries"
                              ChartLabels="@WeekdayLabels"
                              ChartOptions="@chartOptions"
                              LegendPosition="Position.Bottom"
                              Height="220px" Width="100%" Class="mt-2" />

                    <MudDivider Class="my-2" />
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@NextDayIcon" Color="@NextDayColor" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@NextDayText</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline" Class="mt-8 mb-2">
            <MudText Typo="Typo.h6">Területek</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Innen nyílnak a részletes oldalak — ugyanazok, amik a bal oldali menüben vannak.
            </MudText>
        </MudStack>

        <MudGrid Spacing="6">
            @foreach (var tile in Tiles)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="1" Class="pa-4 rounded-lg" Style="height:100%; cursor:pointer"
                              @onclick="@(() => NavigationManager.NavigateTo(tile.Href))">
                        <MudStack Spacing="1" Style="height:100%">
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@tile.Icon" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1">@tile.Title</MudText>
                            </MudStack>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@tile.Pages</MudText>
                            <MudSpacer />
                            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                @if (tile.StatusColor != Color.Default)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="@tile.StatusColor" Style="font-size:0.6rem" />
                                }
                                <MudText Typo="Typo.caption">@tile.Status</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</PageState>

@code {
    private sealed record TileModel(string Title, string Icon, string Pages, string Status, Color StatusColor, string Href);

    private AdminDashboardDto? dashboard;

    /// <summary>A halmozott diagram három sávja: lila–rózsaszín–kék. A hármas színvakság-ellenőrzött
    /// (a legrosszabb szomszédos pár is a küszöb fölött van), és a jelmagyarázat miatt nem csak a szín
    /// különbözteti meg a sávokat.</summary>
    private readonly ChartOptions chartOptions = new()
    {
        ChartPalette = ["#594AE2", "#D6338C", "#1E88E5"],
    };

    private static readonly string[] WeekdayLabels = ["H", "K", "Sze", "Cs", "P"];

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        if (!CurrentUser.IsAdmin)
        {
            NavigationManager.NavigateTo("mai-menu");
            return;
        }

        // Nincs try/catch: a váratlan hibát az AppErrorBoundary rajzolja ki, a többi admin oldallal egyezően.
        dashboard = await Mediator.Send(new GetAdminDashboardQuery(CurrentUser.UserId));
    }

    private string TodayText => dashboard is null
        ? string.Empty
        : dashboard.Today.ToString("yyyy. MMMM d., dddd", System.Globalization.CultureInfo.GetCultureInfo("hu-HU"));

    private string VariantBreakdown => dashboard is null || dashboard.TodayMenuVariants.Count == 0
        ? "Nincs mai menü"
        : string.Join(" · ", dashboard.TodayMenuVariants.Select(v => $"{v.Code} {v.Portions}"));

    private string PeriodSubtitle => dashboard?.ActivePeriod is { } period
        ? $"{period.StartDate:MM. dd.} – {period.EndDate:MM. dd.} · {period.RemainingWorkingDays} munkanap van hátra"
        : "A mai napot egyetlen időszak sem fedi";

    private string MissingMenuSubtitle => dashboard?.FirstMissingDailyMenu is { } first
        ? $"Legkorábbi: {first.ToString("MMM d.", System.Globalization.CultureInfo.GetCultureInfo("hu-HU"))}"
        : "Minden közelgő munkanapra van menü";

    private string TodoCountText => dashboard is null ? string.Empty : $"{dashboard.Todos.Count} tétel";

    private string CancelledText => dashboard is null
        ? string.Empty
        : $"Ma lemondva {dashboard.TodayCancelledPortions} adag.";

    private string ALaCarteSubtitle => dashboard is null
        ? string.Empty
        : $"Aznapi rendelés · {dashboard.TodayALaCarteItemCount} tétel, {dashboard.TodayALaCarteUserCount} dolgozótól · {DeadlineText}";

    private string DeadlineText => dashboard is null
        ? string.Empty
        : dashboard.ALaCarteDeadlinePassed
            ? $"a határidő {dashboard.ALaCarteDeadline:HH\\:mm}-kor lejárt"
            : $"a határidő {dashboard.ALaCarteDeadline:HH\\:mm}";

    private static string OrderedText(int orderedCount)
        => orderedCount == 0 ? "nincs rendelés" : $"{orderedCount} adag";

    private bool NextDayHasOffer => dashboard?.NextWorkingDayHasALaCarteOffer ?? false;

    private string NextDayIcon => NextDayHasOffer ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning;

    private Color NextDayColor => NextDayHasOffer ? Color.Success : Color.Warning;

    private string NextDayText => NextDayHasOffer
        ? "A következő munkanapra már van kiajánlott kínálat."
        : "A következő munkanapra még nincs kiajánlva egyetlen tétel sem.";

    private List<ChartSeries<double>> ALaCarteSeries => dashboard is null
        ? []
        :
        [
            new() { Name = "Leves + főétel", Data = dashboard.WeeklyALaCarte.Select(d => (double)d.SoupAndMainCount).ToArray() },
            new() { Name = "Köret + öntet", Data = dashboard.WeeklyALaCarte.Select(d => (double)d.SideDishCount).ToArray() },
            new() { Name = "Desszert", Data = dashboard.WeeklyALaCarte.Select(d => (double)d.DessertCount).ToArray() },
        ];

    private List<TileModel> Tiles
    {
        get
        {
            if (dashboard is not { } data)
            {
                return [];
            }

            var tiles = data.Tiles;

            return
            [
                new("Naptár", Icons.Material.Filled.CalendarMonth, "Rendelési időszakok · Nem rendelhető napok",
                    $"{tiles.OpenPeriodCount} nyitott időszak · {tiles.FutureExcludedDayCount} kizárt nap", Color.Default, "idoszakok"),

                new("Étlap", Icons.Material.Filled.RestaurantMenu, "Napi menü szerkesztése",
                    data.MissingDailyMenuCount == 0 ? "Minden nap fel van töltve" : $"{data.MissingDailyMenuCount} nap még üres",
                    data.MissingDailyMenuCount == 0 ? Color.Success : Color.Warning, "etlap"),

                new("Rendelések", Icons.Material.Filled.ListAlt, "Napi összesítő · Részletes lista",
                    $"{HungarianNumberFormat.Number(tiles.ActiveOrderCountInPeriod)} aktív rendelés az időszakban", Color.Default, "rendelesek"),

                new("Konyha", Icons.Material.Filled.SoupKitchen, "Konyhai összesítő · Napzárás",
                    data.TodayClosedByKitchen ? "A mai nap lezárva" : "A mai nap nyitva",
                    data.TodayClosedByKitchen ? Color.Success : Color.Warning, "konyhai-osszesito"),

                new("À la carte", Icons.Material.Filled.Fastfood, "Ételek · Napi kínálat · Konyhai lista",
                    $"{tiles.ActiveALaCarteItemCount} aktív étel · ma {data.TodayALaCarteItemCount} rendelt tétel", Color.Default, "alacarte-etelek"),

                new("Jóváírás", Icons.Material.Filled.AccountBalanceWallet, "Egyenlegek · Kézi jóváírás",
                    $"{tiles.UsersWithBalanceCount} dolgozónak van egyenlege", Color.Default, "egyenlegek"),

                new("Számlázás", Icons.Material.Filled.ReceiptLong, "Számlák · Generálás · Fizetettnek jelölés",
                    data.UnpaidInvoiceCount == 0 ? "Nincs fizetetlen számla" : $"{data.UnpaidInvoiceCount} fizetetlen",
                    data.UnpaidInvoiceCount == 0 ? Color.Success : Color.Error, "szamlak"),

                new("Saját rendelésem", Icons.Material.Filled.Person, "Naptár · Rendeléseim · Mai menü · Egyenlegem · Számláim",
                    MyOrderText(tiles), Color.Default, "naptar"),
            ];
        }
    }

    private static string MyOrderText(AdminTileStatsDto tiles)
    {
        var menu = tiles.MyTodayVariantCode is null ? "nincs menürendelés" : $"{tiles.MyTodayVariantCode} menü";
        var aLaCarte = tiles.MyTodayALaCarteItemCount == 0 ? "nincs à la carte" : $"{tiles.MyTodayALaCarteItemCount} à la carte tétel";
        return $"Mára: {menu} · {aLaCarte}";
    }
}
