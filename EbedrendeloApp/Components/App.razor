<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["EbedrendeloApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveModeNoPrerender" />
</head>

<body>
    <Routes @rendermode="InteractiveModeNoPrerender" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    // prerender: false — static prerender minden OnInitializedAsync-et (és a benne futó
    // adatbázis-lekérdezéseket) kétszer futtatná le: egyszer a kezdeti HTTP-válaszhoz, majd újra,
    // amint a SignalR circuit csatlakozik és a komponens újrapéldányosodik. Interaktivitás nélkül a
    // prerender alatt úgyis nem használható (gombok/kattintás nem működnek), ezért ez tiszta
    // duplikált munka — ez okozta a "Mai menü" oldal lassú betöltését.
    private static readonly IComponentRenderMode InteractiveModeNoPrerender = new InteractiveServerRenderMode(prerender: false);
}
