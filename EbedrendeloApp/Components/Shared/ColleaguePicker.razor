@using EbedrendeloApp.Common.Security
@using EbedrendeloApp.Features.Users.GetUsers
@using EbedrendeloApp.Features.Users.ResolveColleague
@using MediatR
@inject IMediator Mediator
@inject ICurrentUser CurrentUser
@implements IDisposable

@* „Kinek rendelek" választó. Más nevében rendelni bárki tud (AC 3.1.6/9.2.2), de ez szándékosan
   nem kiemelt funkció: alapból egy visszafogott link mögé van rejtve, és a dolgozónak azonosítania
   kell a kollégát — név + igazgatóság + osztály, pontos egyezéssel. Végiglapozható névsort ezért NEM
   kínálunk neki. Az adminnak — akinek amúgy is joga van a teljes névsorhoz — autocomplete jut, mert
   neki ez napi munka. *@

@if (Selected is { } selected)
{
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Person">
            @selected.DisplayName
        </MudChip>
        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Undo"
                   OnClick="ClearAsync">
            Vissza a saját naptáramhoz
        </MudButton>
    </MudStack>
}
else
{
    @if (CurrentUser.IsAdmin)
    {
        @* Az adminnak ez napi munka, nála nem kell rejteni. *@
        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                   StartIcon="@(isOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.PersonSearch)"
                   OnClick="@(() => isOpen = !isOpen)">
            Másik dolgozó naptára
        </MudButton>
    }
    else
    {
        @* A dolgozónak NEM kínáljuk fel a funkciót: felirat nélküli, semleges ikon. Aki tudja, hogy
           van ilyen, megtalálja; a felület magától nem hívja fel rá a figyelmet, és a tooltip sem
           azt mondja, hogy „rendelhetsz más nevében". *@
        <MudIconButton Icon="@(isOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.PersonSearch)"
                       Color="Color.Default" Size="Size.Small" title="Másik naptár"
                       OnClick="@(() => isOpen = !isOpen)" />
    }

    @* Feltételes renderelés és nem MudCollapse: az csak becsukja a tartalmat, de a DOM-ban hagyja,
       így a mezők tabbal továbbra is elérhetők lennének — a funkciónak viszont tényleg rejtve kell
       maradnia, amíg valaki nem keresi. *@
    @if (isOpen)
    {
        <MudPaper Elevation="0" Class="border border-solid mud-border-lines-default rounded-lg pa-3 mt-2">
            @if (CurrentUser.IsAdmin)
            {
                <MudAutocomplete T="UserOptionDto" Label="Kolléga" Value="null"
                                 SearchFunc="SearchAsync" ToStringFunc="@(u => u is null ? "" : Describe(u))"
                                 ValueChanged="OnAutocompleteSelectedAsync"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                 AdornmentIcon="@Icons.Material.Filled.PersonSearch" Adornment="Adornment.Start" />
            }
            else
            {
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudTextField @bind-Value="name" Label="Kolléga neve" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Style="min-width:200px;" />
                    <MudTextField @bind-Value="igazgatosag" Label="Igazgatóság" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Style="min-width:160px;" />
                    <MudTextField @bind-Value="osztaly" Label="Osztály" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Style="min-width:160px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonSearch"
                               OnClick="ResolveAsync" Disabled="@(isResolving || !HasAllFields)">
                        Kolléga keresése
                    </MudButton>
                </MudStack>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@errorMessage</MudAlert>
            }
        </MudPaper>
    }
}

@code {
    /// <summary>A kiválasztott kolléga, vagy <c>null</c>, ha a felhasználó a saját nevében jár el.</summary>
    [Parameter]
    public UserOptionDto? Selected { get; set; }

    [Parameter]
    public EventCallback<UserOptionDto?> SelectedChanged { get; set; }

    private string name = string.Empty;
    private string igazgatosag = string.Empty;
    private string osztaly = string.Empty;
    private string? errorMessage;
    private bool isResolving;
    private bool isOpen;

    // A megjelenés admin/dolgozó szerint tér el, ezért itt is meg kell várni a felhasználó betöltését —
    // enélkül az első renderelésen még IsAdmin == false, és az admin is a rejtett dolgozói változatot
    // kapná (a szülő OnInitializedAsync-je nem rendereli újra ezt a gyerekkomponenst).
    protected override async Task OnInitializedAsync()
    {
        CurrentUser.Changed += OnCurrentUserChanged;
        await CurrentUser.EnsureLoadedAsync();
    }

    private void OnCurrentUserChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => CurrentUser.Changed -= OnCurrentUserChanged;

    private bool HasAllFields =>
        !string.IsNullOrWhiteSpace(name)
        && !string.IsNullOrWhiteSpace(igazgatosag)
        && !string.IsNullOrWhiteSpace(osztaly);

    private static string Describe(UserOptionDto user)
    {
        var unit = string.Join(" / ", new[] { user.Igazgatosag, user.Osztaly }.Where(s => !string.IsNullOrWhiteSpace(s)));
        return unit.Length == 0 ? user.DisplayName : $"{user.DisplayName} — {unit}";
    }

    private async Task<IEnumerable<UserOptionDto>> SearchAsync(string? value, CancellationToken cancellationToken)
    {
        var result = await Mediator.Send(new GetUsersQuery(), cancellationToken);
        if (!result.IsSuccess)
        {
            return [];
        }

        var candidates = result.Value!.Where(u => u.Id != CurrentUser.UserId);
        return string.IsNullOrWhiteSpace(value)
            ? candidates
            : candidates.Where(u => Describe(u).Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnAutocompleteSelectedAsync(UserOptionDto? user)
    {
        errorMessage = null;
        await SelectedChanged.InvokeAsync(user);
    }

    private async Task ResolveAsync()
    {
        isResolving = true;
        errorMessage = null;

        var result = await Mediator.Send(new ResolveColleagueQuery(name, igazgatosag, osztaly));
        isResolving = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            return;
        }

        if (result.Value!.Id == CurrentUser.UserId)
        {
            errorMessage = "Ez te magad vagy — a saját naptáradhoz nem kell kolléga-keresés.";
            return;
        }

        await SelectedChanged.InvokeAsync(result.Value);
    }

    private async Task ClearAsync()
    {
        name = string.Empty;
        igazgatosag = string.Empty;
        osztaly = string.Empty;
        errorMessage = null;
        await SelectedChanged.InvokeAsync(null);
    }
}
