# EbedrendeloApp — kódstílus.
# A szabályok a CLAUDE.md „C# standardok" szakaszának gépi fele: ami itt szerepel, az fordításkor
# is látszik (Directory.Build.props → EnforceCodeStyleInBuild). Szándékosan `warning`, nem `error`:
# a meglévő driftek váljanak láthatóvá anélkül, hogy megállítanák a munkát.

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,razor}]
indent_size = 4

[*.cs]

#### Namespace ####

# File-scoped namespace kötelező (CLAUDE.md). Ma a kód 100%-ban ezt használja.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# IDE0005 (felesleges using) szándékosan nincs bekapcsolva: fordításkor csak akkor fut, ha a
# projekt XML doc fájlt is generál (GenerateDocumentationFile), az viszont a hiányzó XML-kommentekre
# önmagában több száz CS1591 figyelmeztetést hozna. Az IDE így is jelzi.

#### CancellationToken ####

# Async hívásba tovább kell adni a tokent (CLAUDE.md: „végigfűzve minden async hívásig").
dotnet_diagnostic.CA2016.severity = warning

#### Modern C# — a repóban használt minták ####

csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent

dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

#### Elrendezés ####

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_using_directive_placement = outside_namespace:warning

#### Elnevezés ####

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal_case_style

dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,enum,delegate
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

#### Generált kód ####

# Az EF Core migrációit a `dotnet ef migrations add` írja, a stílusukat nem mi döntjük el —
# ne termeljenek zajt minden buildnél.
[EbedrendeloApp/Data/Migrations/*.cs]
dotnet_diagnostic.IDE0161.severity = none
dotnet_analyzer_diagnostic.severity = none
generated_code = true
